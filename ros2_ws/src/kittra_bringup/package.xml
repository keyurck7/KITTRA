<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>kittra_bringup</name>
  <version>0.2.0</version>
  <description>Launch files for the Kittra cell (simulation now, hardware in Phase 3).</description>
  <maintainer email="keyurck7@users.noreply.github.com">Keyur Chaudhari</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>kittra_description</exec_depend>
  <exec_depend>kittra_bridge</exec_depend>
  <exec_depend>kittra_policy</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
